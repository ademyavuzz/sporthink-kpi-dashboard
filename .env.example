# -----------------------------------------------------------------------------
# Sporthink KPI Dashboard — Root Environment Variables
# -----------------------------------------------------------------------------
# Bu dosya `docker-compose.dev.yml` tarafından otomatik okunur.
# Kullanım: `cp .env.example .env` ve değerleri kendi ortamına göre düzenle.
# `.env` dosyası asla commit edilmez (`.gitignore`).
# -----------------------------------------------------------------------------

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root_dev_pw
MYSQL_DATABASE=sporthink_dashboard
MYSQL_USER=sporthink
MYSQL_PASSWORD=sporthink_dev_pw

# --- JWT ---
# Production'da en az 64 karakter rastgele string. Asla varsayılanı bırakma.
JWT_SECRET_KEY=dev-secret-change-in-production-this-must-be-at-least-64-characters-long

# --- E-posta (SendGrid) ---
# Dev'de boş bırakılabilir; şifre sıfırlama akışında loglanır.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@sporthink.local

# --- Süper Admin (initial seed) ---
# `python -m app.seed` ilk çalıştığında bu bilgilerle Süper Admin oluşturur.
# Production'da güçlü bir şifre ile değiştir.
SUPER_ADMIN_EMAIL=admin@sporthink.local
SUPER_ADMIN_PASSWORD=ChangeMe!1234567890
