# Production environment example.
# Production'da `cp .env.production.example .env` ve gerçek değerleri doldur.
# `.env` ASLA commit edilmez (.gitignore).

APP_ENV=production

# --- MySQL ---
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_root_password_here
MYSQL_DATABASE=sporthink_dashboard
MYSQL_USER=sporthink
MYSQL_PASSWORD=CHANGE_ME_strong_user_password_here
DATABASE_URL=mysql+aiomysql://sporthink:CHANGE_ME_strong_user_password_here@mysql:3306/sporthink_dashboard

# --- Redis ---
REDIS_CACHE_URL=redis://redis:6379/0
REDIS_BROKER_URL=redis://redis:6379/1

# --- JWT (en az 64 karakter) ---
JWT_SECRET_KEY=CHANGE_ME_64_chars_minimum_use_openssl_rand_hex_32_for_strong_random
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Süper Admin (ilk seed sırasında oluşturulur) ---
SUPER_ADMIN_EMAIL=admin@sporthink.com.tr
SUPER_ADMIN_PASSWORD=CHANGE_ME_strong_password_min_10_chars

# --- E-posta (Gmail SMTP — davet & şifre sıfırlama) ---
# Gmail App Password: https://myaccount.google.com/apppasswords
# `MAIL_FROM` ve `SMTP_USER` aynı adres olmak zorunda (Gmail relay).
# Production yüksek hacim için SendGrid/Postmark gibi servise taşınabilir.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=
MAIL_FROM_NAME=Sporthink Dashboard
INVITE_TOKEN_EXPIRE_HOURS=168
RESET_TOKEN_EXPIRE_MINUTES=60

# --- CORS / Frontend origin ---
# Faz 1 (domain yok): http://<VDS-IP> | Faz 2 (domain+SSL): https://<domain>
# Davet/sifre-sifirlama mail linklerinde ve CORS allowlist'inde kullanilir.
FRONTEND_ORIGIN=https://dashboard.sporthink.com.tr

# --- Upload limits ---
UPLOAD_DIR=/var/sporthink/uploads
IMPORT_MAX_FILE_SIZE_MB=50

# --- Deployment tuning ---
# Gunicorn worker sayisi (RAM'e gore). 4 GB RAM -> 2, 8 GB+ -> 4.
GUNICORN_WORKERS=4
# Aktif nginx config: Faz 1 (HTTP/IP) -> ./nginx/app-http.conf
#                     Faz 2 (HTTPS/domain) -> ./nginx/sporthink.conf
NGINX_CONF=./nginx/app-http.conf
