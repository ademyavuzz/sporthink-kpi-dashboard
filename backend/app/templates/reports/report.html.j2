<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8" />
  <title>{{ report_title }}</title>
  <style>{{ css | safe }}</style>
</head>
<body>

<header class="page-header">
  <img class="header-logo" src="sporthink-logo.png" alt="Sporthink" />
  <span class="header-range">{{ date_from_str }} — {{ date_to_str }}</span>
</header>

<footer class="page-footer">
  <span>{{ footer_label }}</span>
  <span class="footer-sep">·</span>
  <span>{{ generated_at_str }}</span>
</footer>

<!-- ============================== COVER ============================== -->
<section class="cover">
  <img class="cover-logo" src="sporthink-logo.png" alt="Sporthink" />
  <h1 class="cover-title">{{ report_title }}</h1>
  <p class="cover-subtitle">{{ subtitle }}</p>
  <div class="cover-pill">{{ date_from_str }} — {{ date_to_str }}</div>
  <div class="cover-meta">
    <div class="cover-meta-row">
      <span class="cover-meta-label">{{ labels.prepared_by }}</span>
      <span class="cover-meta-value">{{ created_by_name }}</span>
    </div>
    <div class="cover-meta-row">
      <span class="cover-meta-label">{{ labels.generated_at }}</span>
      <span class="cover-meta-value">{{ generated_at_str }}</span>
    </div>
    <div class="cover-meta-row">
      <span class="cover-meta-label">{{ labels.sections }}</span>
      <span class="cover-meta-value">
        {% set ns = namespace(idx=0) %}
        {% for s in sections %}{% if s in section_label_map %}{% set ns.idx = ns.idx + 1 %}<span class="toc-item"><span class="toc-num">{{ ns.idx }}.</span> {{ section_label_map[s] }}</span>{% if not loop.last %} · {% endif %}{% endif %}{% endfor %}
      </span>
    </div>
  </div>
</section>

<!-- ============================== EXECUTIVE SUMMARY ============================== -->
<section class="report-section section-exec">
  <h2 class="section-title">{{ labels.executive_summary }}</h2>
  <p class="section-desc">{{ labels.executive_summary_desc }}</p>

  {% if exec_summary.headline_kpis %}
  <div class="kpi-grid">
    {% for k in exec_summary.headline_kpis %}
    <div class="kpi-card kpi-card-headline">
      <div class="kpi-label">{{ k.label }}</div>
      <div class="kpi-value">{{ k.value }}</div>
      {% if k.change is not none %}
      <div class="kpi-change kpi-change-{{ k.change_dir }}">{{ k.change }}</div>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if exec_summary.narrative %}
  <p class="exec-narrative">{{ exec_summary.narrative }}</p>
  {% endif %}

  <div class="exec-twocol">
    <div class="exec-col exec-wins">
      <div class="exec-col-title">
        <span class="exec-col-bullet exec-col-bullet-wins"></span>
        {{ labels.wins_title }}
      </div>
      {% if exec_summary.wins %}
      <ul class="exec-list">
        {% for w in exec_summary.wins %}
        <li>{{ w }}</li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="exec-empty">{{ labels.no_wins }}</p>
      {% endif %}
    </div>
    <div class="exec-col exec-concerns">
      <div class="exec-col-title">
        <span class="exec-col-bullet exec-col-bullet-concerns"></span>
        {{ labels.concerns_title }}
      </div>
      {% if exec_summary.concerns %}
      <ul class="exec-list">
        {% for c in exec_summary.concerns %}
        <li>{{ c }}</li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="exec-empty">{{ labels.no_concerns }}</p>
      {% endif %}
    </div>
  </div>

  <p class="exec-footnote">{{ labels.comparison_note }}</p>
</section>

{% if "overview" in sections %}
<section class="report-section section-overview">
  <h2 class="section-title">{{ labels.overview }}</h2>
  <p class="section-desc">{{ labels.overview_desc }}</p>

  <div class="kpi-grid">
    {% for k in overview_kpis %}
    <div class="kpi-card">
      <div class="kpi-label">{{ k.label }}</div>
      <div class="kpi-value">{{ k.value }}</div>
      {% if k.change is not none %}
      <div class="kpi-change kpi-change-{{ k.change_dir }}">{{ k.change }}</div>
      {% endif %}
    </div>
    {% endfor %}
  </div>

  {% if overview_chart_svg %}
  <div class="chart-block">
    <div class="chart-title">{{ labels.daily_revenue_trend }}</div>
    {{ overview_chart_svg | safe }}
  </div>
  {% endif %}
</section>
{% endif %}

{% if "ga4" in sections %}
<section class="report-section section-ga4">
  <h2 class="section-title">{{ labels.ga4 }}</h2>
  <p class="section-desc">{{ labels.ga4_desc }}</p>

  {% if channel_bar_svg %}
  <div class="chart-block">
    <div class="chart-title">{{ labels.revenue_by_channel }}</div>
    {{ channel_bar_svg | safe }}
  </div>
  {% endif %}

  <table class="data-table">
    <thead>
      <tr>
        <th class="t-left">{{ labels.channel }}</th>
        <th class="t-right">{{ labels.sessions }}</th>
        <th class="t-right">{{ labels.orders }}</th>
        <th class="t-right">{{ labels.revenue }}</th>
        <th class="t-right">{{ labels.conv_rate }}</th>
      </tr>
    </thead>
    <tbody>
      {% for r in channel_rows %}
      <tr>
        <td class="t-left">{{ r.channel }}</td>
        <td class="t-right">{{ r.sessions }}</td>
        <td class="t-right">{{ r.orders }}</td>
        <td class="t-right">{{ r.revenue }}</td>
        <td class="t-right">{{ r.conv_rate }}</td>
      </tr>
      {% endfor %}
      {% if not channel_rows %}
      <tr><td colspan="5" class="t-center muted">{{ labels.no_data }}</td></tr>
      {% endif %}
    </tbody>
  </table>
</section>
{% endif %}

{% if "ads" in sections %}
<section class="report-section section-ads">
  <h2 class="section-title">{{ labels.ads }}</h2>
  <p class="section-desc">{{ labels.ads_desc }}</p>

  <div class="kpi-grid">
    {% for k in ads_kpis %}
    <div class="kpi-card">
      <div class="kpi-label">{{ k.label }}</div>
      <div class="kpi-value">{{ k.value }}</div>
      {% if k.change is not none %}
      <div class="kpi-change kpi-change-{{ k.change_dir }}">{{ k.change }}</div>
      {% endif %}
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if "ecommerce" in sections %}
<section class="report-section section-ecom">
  <h2 class="section-title">{{ labels.ecommerce }}</h2>
  <p class="section-desc">{{ labels.ecommerce_desc }}</p>

  <div class="kpi-grid kpi-grid-3">
    {% for k in ecom_kpis %}
    <div class="kpi-card">
      <div class="kpi-label">{{ k.label }}</div>
      <div class="kpi-value">{{ k.value }}</div>
      {% if k.change is not none %}
      <div class="kpi-change kpi-change-{{ k.change_dir }}">{{ k.change }}</div>
      {% endif %}
    </div>
    {% endfor %}
  </div>

  {% if new_returning_svg %}
  <div class="chart-block chart-block-tight">
    <div class="chart-title">{{ labels.new_vs_returning }}</div>
    <p class="chart-sub">{{ labels.new_vs_returning_desc }}</p>
    {{ new_returning_svg | safe }}
  </div>
  {% endif %}
</section>
{% endif %}

{% if "funnel" in sections %}
<section class="report-section section-funnel">
  <h2 class="section-title">{{ labels.funnel }}</h2>
  <p class="section-desc">{{ labels.funnel_desc }}</p>

  {% if funnel_chart_svg %}
  <div class="chart-block">
    {{ funnel_chart_svg | safe }}
  </div>
  {% else %}
  <p class="muted">{{ labels.no_data }}</p>
  {% endif %}
</section>
{% endif %}

{% if "top" in sections %}
<section class="report-section section-top">
  <h2 class="section-title">{{ labels.top }}</h2>
  <p class="section-desc">{{ labels.top_desc }}</p>

  <h3 class="subsection-title">{{ labels.top_products }}</h3>
  <table class="data-table">
    <thead>
      <tr>
        <th class="t-left">{{ labels.sku }}</th>
        <th class="t-left">{{ labels.product }}</th>
        <th class="t-right">{{ labels.units }}</th>
        <th class="t-right">{{ labels.revenue }}</th>
      </tr>
    </thead>
    <tbody>
      {% for p in top_products %}
      <tr>
        <td class="t-left">{{ p.sku }}</td>
        <td class="t-left">{{ p.name }}</td>
        <td class="t-right">{{ p.units }}</td>
        <td class="t-right">{{ p.revenue }}</td>
      </tr>
      {% endfor %}
      {% if not top_products %}
      <tr><td colspan="4" class="t-center muted">{{ labels.no_data }}</td></tr>
      {% endif %}
    </tbody>
  </table>

  <h3 class="subsection-title">{{ labels.top_customers }}</h3>
  <table class="data-table">
    <thead>
      <tr>
        <th class="t-left">{{ labels.customer }}</th>
        <th class="t-left">{{ labels.city }}</th>
        <th class="t-right">{{ labels.orders }}</th>
        <th class="t-right">{{ labels.revenue }}</th>
      </tr>
    </thead>
    <tbody>
      {% for c in top_customers %}
      <tr>
        <td class="t-left">{{ c.name }}</td>
        <td class="t-left">{{ c.city }}</td>
        <td class="t-right">{{ c.orders }}</td>
        <td class="t-right">{{ c.revenue }}</td>
      </tr>
      {% endfor %}
      {% if not top_customers %}
      <tr><td colspan="4" class="t-center muted">{{ labels.no_data }}</td></tr>
      {% endif %}
    </tbody>
  </table>
</section>
{% endif %}

</body>
</html>
