# -----------------------------------------------------------------------------
# Sporthink Backend — Environment Variables
# -----------------------------------------------------------------------------
# Bu dosya backend Docker dışında lokal çalıştırıldığında kullanılır.
# Docker üzerinden çalışıldığında `docker-compose.dev.yml`'deki environment
# blokları geçerlidir; o değerler kök `/.env` dosyasından beslenir.
# -----------------------------------------------------------------------------

# --- Uygulama ---
APP_ENV=development

# --- Veritabanı ---
DATABASE_URL=mysql+aiomysql://sporthink:sporthink_dev_pw@localhost:3306/sporthink_dashboard

# --- Redis ---
# db 0 = uygulama cache, db 1 = Celery broker. Karıştırma.
REDIS_CACHE_URL=redis://localhost:6379/0
REDIS_BROKER_URL=redis://localhost:6379/1

# --- JWT ---
JWT_SECRET_KEY=dev-secret-change-in-production-this-must-be-at-least-64-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- E-posta (SendGrid) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@sporthink.local

# --- Süper Admin (ilk kurulum / seed) ---
SUPER_ADMIN_EMAIL=admin@sporthink.local
SUPER_ADMIN_PASSWORD=ChangeMe!1234567890
