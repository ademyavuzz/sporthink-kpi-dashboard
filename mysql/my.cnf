# Production MySQL 8.4 LTS tuning — single-host VDS, ~50 concurrent users,
# 1 yıllık veri (~10M satır agregate, ~1M satır transactional).

[mysqld]
# Character set
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Connection
max_connections = 200
max_allowed_packet = 64M
wait_timeout = 600
interactive_timeout = 600

# InnoDB
# NOT: Hedef VDS 3.8 GB RAM (2 vCPU). 1G buffer pool + gunicorn worker'lari +
# celery + redis bu boyutta OOM riski yaratiyordu; veri seti kucuk oldugu icin
# 512M fazlasiyla yeterli. Daha buyuk RAM'li sunucuda 1G/2G'ye cikarilabilir.
innodb_buffer_pool_size = 512M
innodb_log_file_size = 256M
innodb_flush_log_at_trx_commit = 1
innodb_flush_method = O_DIRECT
innodb_file_per_table = 1

# Query cache (MySQL 8 kapalı — application-level cache var)

# Slow query log — tuning için
# NOT: Resmi mysql imajinda /var/log/mysql yok; mysql kullanicisinin yazabildigi
# data dizinine yaziyoruz (aksi halde "Could not open ... slow.log" uyarisi).
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 1.0

# Auth plugin — caching_sha2_password MySQL 8.4'te zaten default.
# NOT: `default_authentication_plugin` 8.4'te tamamen KALDIRILDI; tanimlanirsa
# mysqld "unknown variable" hatasiyla baslamaz. Default davranis dogru.

[client]
default-character-set = utf8mb4
