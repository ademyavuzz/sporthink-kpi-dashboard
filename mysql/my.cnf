# Production MySQL 8.4 LTS tuning — single-host VDS, ~50 concurrent users,
# 1 yıllık veri (~10M satır agregate, ~1M satır transactional).

[mysqld]
# Character set
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Connection
max_connections = 200
max_allowed_packet = 64M
wait_timeout = 600
interactive_timeout = 600

# InnoDB
innodb_buffer_pool_size = 1G
innodb_log_file_size = 256M
innodb_flush_log_at_trx_commit = 1
innodb_flush_method = O_DIRECT
innodb_file_per_table = 1

# Query cache (MySQL 8 kapalı — application-level cache var)

# Slow query log — tuning için
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 1.0

# Auth plugin — caching_sha2_password (MySQL 8 default, cryptography lib gerek)
default_authentication_plugin = caching_sha2_password

[client]
default-character-set = utf8mb4
